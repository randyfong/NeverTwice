# NeverTwice Environment Configuration Template

APP_ENV=development
LOG_LEVEL=INFO

# MongoDB Atlas (Vector Memory Engine)
MONGODB_ATLAS_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=nevertwice_memory

# Google DeepMind Judge & Embeddings (Gemini 2.5 / text-embedding-004)
GOOGLE_API_KEY=your_google_gemini_api_key

# Subquadratic Context Reconstructor
SUBQUADRATIC_API_KEY=your_subq_api_key
SUBQUADRATIC_BASE_URL=https://api.subquadratic.ai/v1
SUBQ_TIMEOUT_SECONDS=3.5

# Meta Model API Swarm
META_API_KEY=your_meta_api_key
META_BASE_URL=https://api.meta.ai/v1
META_TIMEOUT_SECONDS=8.0

# Sandbox Runner
SANDBOX_TIMEOUT_SECONDS=5.0

# Fetch.ai uAgents Protocol
FETCHAI_AGENT_NAME=nevertwice_pipeline_agent
FETCHAI_AGENT_SEED=nevertwice_super_secret_recovery_seed_phrase
FETCHAI_AGENT_PORT=8001
# Public HTTPS URL forwarding to the uAgent port (8001), including /submit.
FETCHAI_AGENT_ENDPOINT=https://nevertwice-777537491035.us-west1.run.app/submit
AGENTVERSE_API_KEY=
FETCHAI_MAILBOX_KEY=

